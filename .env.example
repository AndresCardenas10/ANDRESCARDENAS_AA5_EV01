# Plantilla de configuracion. Copie este archivo como ".env" y ajuste los valores.
# El archivo ".env" NO se sube al repositorio (esta en .gitignore).

# Puerto donde escucha el servicio web
PORT=3000

# Conexion a MySQL (valores por defecto de XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aa5_ev01_auth
